# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# LOCAL (npm run db:start → npm run db:status prints these):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE-LOCAL-ANON-KEY-FROM-db:status
#
# CLOUD (Dashboard → Project Settings → API):
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---------------------------------------------------------------------------
# Google Gemini  ·  https://aistudio.google.com/apikey  (Free tier is fine)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=YOUR-GEMINI-API-KEY
# Free-tier friendly: gemini-2.5-flash (default), gemini-2.5-flash-lite, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
